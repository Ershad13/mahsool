# Mahsool Podfile
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronous priority.
# Disable it to prevent blocking the build.
install! 'cocoapods', :deterministic_uuids => false

# Flutter Pods
# The flutter_install_all_ios_pods method is usually defined in Flutter/podhelper.rb
# which is generated by 'flutter pub get' or 'flutter build'.
# Since we might not have it yet, we use a standard structure that the CI will populate.

load File.join(File.dirname(__FILE__), 'Flutter', 'podhelper.rb')

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
end
